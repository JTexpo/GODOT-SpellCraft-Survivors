class_name BaseModifiers
extends Resource
## What a Base scroll does to an Area's baseline. 1.0 changes nothing. These keep each element's
## personality (Thunder fast and light, Land slow and heavy) whichever Area it is crafted into.

@export var damage: float = 1.0
@export var cast_interval: float = 1.0
@export var mana_cost: float = 1.0
@export var max_mana: float = 1.0
@export var projectile_speed: float = 1.0
@export var knockback: float = 1.0
